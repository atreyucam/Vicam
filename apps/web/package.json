{
  "name": "@vicam/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/ui build",
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint src tests vite.config.ts playwright.config.ts playwright.fullstack.config.ts --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@vicam/contracts": "workspace:*",
    "@vicam/ui": "workspace:*",
    "dexie": "4.4.4",
    "lucide-react": "1.25.0",
    "maplibre-gl": "6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
