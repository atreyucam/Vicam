{
  "name": "@vicam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "auth:reset-manager": "tsx src/cli/reset-manager-password.ts",
    "pretest": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "test": "vitest run src",
    "pretypecheck": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vicam/contracts": "workspace:*",
    "@vicam/db": "workspace:*",
    "argon2": "0.45.0",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "multer": "^2.2.0",
    "pdfkit": "0.17.2",
    "pino": "10.3.1",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "26.1.1",
    "@types/pdfkit": "0.17.5",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "pg": "8.22.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
