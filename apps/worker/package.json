{
  "name": "@vicam/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "test": "vitest run src",
    "pretypecheck": "pnpm --filter @vicam/contracts build && pnpm --filter @vicam/db build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vicam/contracts": "workspace:*",
    "@vicam/db": "workspace:*",
    "exceljs": "4.4.0",
    "pdfkit": "0.17.2",
    "pg-boss": "12.26.1",
    "pino": "10.3.1",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pdfkit": "0.17.5",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
