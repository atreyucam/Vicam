# Configuración no secreta del monitor. El webhook debe ir en un secret de CI.
VICAM_MONITOR_URL=https://staging.app.vicamproduce.com
VICAM_MONITOR_TIMEOUT_MS=10000
VICAM_MONITOR_MIN_CERT_DAYS=14
VICAM_MONITOR_NOTIFY_SUCCESS=false
# VICAM_MONITOR_WEBHOOK_URL se omite deliberadamente: no guarde webhooks reales aquí.
