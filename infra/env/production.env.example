# No use datos ni secretos de staging. Los secretos viven solo en el VPS o gestor aprobado.
VICAM_PUBLIC_HOST=app.vicamproduce.com
VICAM_CADDY_EMAIL=ops@example.invalid
VICAM_POSTGRES_DB=vicam_production
VICAM_POSTGRES_USER=vicam_production
VICAM_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
VICAM_AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
VICAM_CLAMD_HOST=clamav
VICAM_CLAMD_PORT=3310
VICAM_VAPID_SUBJECT=https://app.vicamproduce.com
VICAM_VAPID_PUBLIC_KEY=REPLACE_WITH_PRODUCTION_VAPID_PUBLIC_KEY
VICAM_VAPID_PRIVATE_KEY=REPLACE_WITH_PRODUCTION_VAPID_PRIVATE_KEY
VICAM_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/REPLACE_WITH_STYLE_ID/style.json
VICAM_MAPLIBRE_API_KEY=REPLACE_WITH_RESTRICTED_PRODUCTION_BROWSER_KEY
VICAM_CSP_MAP_CONNECT_SRC=https://api.maptiler.com https://*.maptiler.com
VICAM_CSP_MAP_IMG_SRC=https://api.maptiler.com https://*.maptiler.com
VICAM_API_IMAGE=ghcr.io/OWNER/vicam-api@sha256:REPLACE_WITH_64_HEX_DIGEST
VICAM_WORKER_IMAGE=ghcr.io/OWNER/vicam-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
VICAM_WEB_IMAGE=ghcr.io/OWNER/vicam-web@sha256:REPLACE_WITH_64_HEX_DIGEST
VICAM_BACKUP_IMAGE=ghcr.io/OWNER/vicam-backup@sha256:REPLACE_WITH_64_HEX_DIGEST
VICAM_LOG_LEVEL=info
VICAM_OFFLINE_SYNC_ENABLED=true
VICAM_BACKUP_RETENTION_DAYS=14
VICAM_BACKUP_INTERVAL_SECONDS=86400
VICAM_BACKUP_HEALTH_MAX_AGE_MINUTES=1500
